# PersonaBot Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Get your FREE API key at: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────

# ── OpenRouter API ────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ── AI Model (Free options below) ────────────────────────────────
# mistralai/mistral-7b-instruct          ← Best free option
# google/gemma-3-27b-it:free             ← Google Gemma (free)
# openai/gpt-3.5-turbo                   ← Paid but cheap
# anthropic/claude-3-haiku               ← Very capable
AI_MODEL=openai/gpt-4o-mini

# ── Chatbot Branding (Customize per client) ───────────────────────
BOT_NAME=PersonaBot
BOT_TAGLINE=Your Intelligent Business Assistant
BOT_AVATAR=🤖
BOT_ROLE=professional business assistant
BUSINESS_NAME=PersonaBot Inc.
WELCOME_MESSAGE=Hello! I'm your AI assistant. Upload your documents and ask me anything!

# ── UI Customization ─────────────────────────────────────────────
PRIMARY_COLOR=#6C63FF

# ── Server Settings ──────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=true
