# ═══════════════════════════════════════════════════
# PersonaBot - Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ═══════════════════════════════════════════════════

# ── OpenRouter API ──────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── AI Model ───────────────────────────────────────
# Options: mistralai/mistral-7b-instruct | openai/gpt-3.5-turbo | anthropic/claude-3-haiku
AI_MODEL=mistralai/mistral-7b-instruct

# ── Chatbot Identity (customize per client) ─────────
BOT_NAME=PersonaBot
BOT_TAGLINE=Your Intelligent Business Assistant
BOT_AVATAR=🤖
BOT_ROLE=professional business assistant
BUSINESS_NAME=PersonaBot Inc.
WELCOME_MESSAGE=Hello! I'm your AI assistant. Upload your documents and ask me anything!

# ── UI Customization ───────────────────────────────
PRIMARY_COLOR=#6C63FF

# ── Server Settings ────────────────────────────────
PORT=5000
FLASK_DEBUG=true
